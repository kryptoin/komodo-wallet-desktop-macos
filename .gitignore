# Apple Silicon native build (see build_apple_silicon.sh): local libwally-core
# checkout + install prefix. Its .pc files embed absolute home-dir paths, so
# this must never be committed.
/.deps/

# FetchContent / build script outputs staged into the source tree (regenerated
# every configurerun; the tracked imports/qml.qrc is intentionally NOT listed)
/atomic_defi_design/Dex/qml.qrc
/atomic_defi_design/assets/qml.qrc
/atomic_defi_design/assets/images/coins/
/atomic_defi_design/imports/bignumberjs/bignumber.js/bignumber.js

# macOS installer image (produced by osx_post_install.cmake into bundled/osx/)
*.dmg

# ==============================================================================
# Documentation & Configurations
# ==============================================================================
/doc/doxygen/
/doc/manual.html
/docs/**/*.md
/docs/*.md
/graph.png
.gitconfig
# NOTE: no blanket *.yaml rule -- it would silently exclude CI workflow and
# config files added later. Ignore specific generated yaml files instead.
# Hand-written working docs stay tracked:
!/docs/implementation_plan.md

# ==============================================================================
# Exceptions (Ensure these ARE tracked by Git)
# ==============================================================================
# Ignore coredumps, but never the src/core/ source tree (an unanchored `core`
# pattern would match that directory; anchored + explicit exception instead).
*.core
/core
!/core/
!src/core/

# Keep docs images explicitly tracked
!/docs/images/